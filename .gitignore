# I8 evaluation runs: keep manifest/summary/tables/validation_report (the
# scientifically useful, reproducible-analysis artifacts); the raw/
# subfolder (pipeline trace JSONL + repair_attempts.sqlite) is runtime
# scratch, fully reconstructable by re-running scripts/run_evaluation.py
# against the same manifest, and is deliberately not versioned. This is a
# narrow rule scoped to raw/ only - future evaluation summaries/tables are
# not ignored.
data/evaluation/*/raw/

# I8 machine-specific FixApplicator override config (absolute local DB
# path) - see config/fix_applicator.evaluation.example.yaml for the
# committed, path-free template.
config/fix_applicator.evaluation.local.yaml
