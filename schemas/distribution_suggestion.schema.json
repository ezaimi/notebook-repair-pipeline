{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM Distribution Suggestion",
  "type": "object",
  "additionalProperties": false,
  "required": ["suggested_distribution", "rationale"],
  "properties": {
    "suggested_distribution": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  }
}
